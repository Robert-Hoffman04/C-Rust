#include <std::fmt>

int main()
{
    float j = 0.0;
    char t = '\n';
    printf("Float value is now: %j%c", j, t);
    for (j; j < 10; j++)
        printf("Float value is now: %d%c", j, t);

    if (j > 7)
        printf("this if has no brackets\n");
    else if (j > 8)
        printf("No bracket Else if\n");
    else
    {
        printf("This was printed across");
        printf("two lines in an else block\n");
    }
}
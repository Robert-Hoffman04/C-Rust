#include <tiny_http::{Server, Response, Request}>
#include <std::fs::{File, read}>
#include <std::io::Read>

char* get_path(char* url)
{
    if (url == "/")
    {
        return "static/index.html";
    }
    else {
        auto chars = url.chars();
        chars.next();
        return chars.as_str();
    }
}

void main()
{
    Server server = Server::http("0.0.0.0:8000").unwrap();

    while (true)
    {
        auto opReq = server.recv();
        if (opReq.is_err())
        {
            continue;
        }
        Request request = opReq.unwrap();

        char* url = request.url();

        char* path = get_path(url);
        Macro::println("Request: {}", path);

        auto response = read(&path);
        if (response.is_err())
        {
            request.respond(Response::from_string("404"));
        }
        else
        {
            request.respond(Response::from_data(response.unwrap()));
        }
    }
}